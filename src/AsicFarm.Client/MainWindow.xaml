<Window x:Class="AsicFarm.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:AsicFarm.Client.ViewModels"
        xmlns:beh="clr-namespace:AsicFarm.Client.Behaviors"
        Title="AsicFarm Monitor"
        Height="980" Width="1600"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CONNECTION BAR -->
        <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Сервер:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="2" Text="API-ключ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,16,0"/>

                <!-- ПИНГ СЕРВЕРА -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="NetworkCheck24" Filled="True" Foreground="{Binding ServerPingColor}" Margin="0,0,6,0"/>
                    <TextBlock Text="Сервер:" VerticalAlignment="Center" Foreground="#9aa0a6"/>
                    <TextBlock Text="{Binding ServerPingDisplay}" Foreground="{Binding ServerPingColor}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <ui:Button Grid.Column="5" Content="Подключить" Margin="0,0,8,0" Icon="{ui:SymbolIcon PlugConnected24}" Appearance="Primary" Command="{Binding ConnectCommand}"/>
                <ui:Button Grid.Column="6" Content="Обновить" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <!-- FARM METRICS -->
        <Border Grid.Row="1" Padding="16,12" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Общий хешрейт" FontSize="11" Foreground="#9aa0a6"/>
                    <TextBlock Text="{Binding TotalHashrateDisplay}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock FontSize="11" Foreground="#9aa0a6"><Run Text="Онлайн: "/><Run Text="{Binding OnlineDisplay, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Потребление" FontSize="11" Foreground="#9aa0a6"/>
                    <TextBlock Text="{Binding TotalPowerDisplay}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DailyPowerDisplay}" FontSize="11" Foreground="#9aa0a6"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Курс BTC" FontSize="11" Foreground="#9aa0a6"/>
                    <TextBlock Text="{Binding BtcPriceDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="#f7931a"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Сложность сети" FontSize="11" Foreground="#9aa0a6"/>
                    <TextBlock Text="{Binding DifficultyDisplay}" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Доход в BTC / сутки" FontSize="11" Foreground="#9aa0a6"/>
                    <TextBlock Text="{Binding DailyBtcDisplay}" FontSize="16" FontWeight="SemiBold" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock Text="Доход в USD / сутки" FontSize="11" Foreground="#9aa0a6"/>
                    <TextBlock Text="{Binding DailyUsdDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="#5cb85c"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">

            <!-- МАЙНЕРЫ -->
            <TabItem Header="Устройства">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Отображение:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9aa0a6"/>
                            <ComboBox ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" Width="140" Margin="0,0,20,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="—"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="Cards">
                                                            <Setter Property="Text" Value="Карточки"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="Compact">
                                                            <Setter Property="Text" Value="Список"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9aa0a6"/>
                            <ComboBox ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" Width="240" Margin="0,0,20,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="—"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="ProblemsFirst">
                                                            <Setter Property="Text" Value="Сначала проблемные"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="HashrateAsc">
                                                            <Setter Property="Text" Value="По хешрейту (возр.)"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="HashrateDesc">
                                                            <Setter Property="Text" Value="По хешрейту (убыв.)"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="TempDesc">
                                                            <Setter Property="Text" Value="Сначала горячие"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="EfficiencyDesc">
                                                            <Setter Property="Text" Value="Сначала неэффективные"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="NameAsc">
                                                            <Setter Property="Text" Value="По алфавиту"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Агент:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9aa0a6"/>
                            <ComboBox ItemsSource="{Binding WatchdogFilters}" SelectedItem="{Binding SelectedWatchdogFilter}" Width="220" Margin="0,0,20,0" DisplayMemberPath="DisplayName"/>
                            <CheckBox Content="Только с ошибками" IsChecked="{Binding ShowOnlyProblems}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточки -->
                    <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="Cards">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding MinersView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MinerItemViewModel}">
                                    <ui:Card Padding="0" Margin="0,0,0,12">
                                        <Grid>
                                            <Border HorizontalAlignment="Left" Width="4" Background="{Binding StateColor}" CornerRadius="6,0,0,6"/>
                                            <Grid Margin="20,16,20,16">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding StateColor}"/>
                                                        <TextBlock FontSize="16" FontWeight="SemiBold"><Run Text="{Binding Model}"/></TextBlock>
                                                        <TextBlock FontSize="13" Margin="10,2,0,0" Foreground="#9aa0a6">
                                                            <Hyperlink Command="{Binding OpenWebUiCommand}" Foreground="#9aa0a6" TextDecorations="None">
                                                                <Run Text="{Binding Ip}"/>
                                                            </Hyperlink>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Margin="10,4,0,0" Foreground="#9aa0a6" Text="{Binding UptimeText}"/>
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Right" Padding="10,3" CornerRadius="10" Background="{Binding StateColor}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State, Converter={StaticResource EnumRu}}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </DockPanel>

                                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                        <TextBlock Text="ХЕШРЕЙТ" FontSize="10" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                                        <TextBlock Text="{Binding HashrateDisplay, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                        <Grid Margin="0,6,0,0" HorizontalAlignment="Left" Width="260">
                                                            <Border Height="6" CornerRadius="3" Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                            <Border Height="6" CornerRadius="3" HorizontalAlignment="Left" Background="{Binding HashrateBarColor}" Width="{Binding HashratePercent, Converter={StaticResource PctToW}}"/>
                                                        </Grid>
                                                        <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="#9aa0a6"><Run Text="{Binding HashratePercent, StringFormat={}{0:F1}%}"/><Run Text=" от нормы"/></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                                        <TextBlock Text="ТЕМПЕРАТУРА" FontSize="10" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                                        <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"><Run Text="{Binding ChipMaxTemp}"/><Run Text="°C"/></TextBlock>
                                                        <TextBlock Text="{Binding PsuTempsText}" FontSize="10" Margin="0,6,0,0" Foreground="#9aa0a6" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0,0,20,0">
                                                        <TextBlock Text="ПОТРЕБЛЕНИЕ" FontSize="10" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                                        <TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"><Run Text="{Binding PowerW}"/><Run Text=" Вт"/></TextBlock>
                                                        <TextBlock Text="{Binding EfficiencyText}" FontSize="11" Margin="0,6,0,0" Foreground="#9aa0a6"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="ПРОШИВКА" FontSize="10" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                                        <TextBlock Text="{Binding Firmware}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Hostname}" FontSize="11" Margin="0,2,0,0" Foreground="#9aa0a6"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="2" Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding BestShareText}" FontSize="11" Foreground="#9aa0a6"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FoundBlocksText}" FontSize="11" Foreground="#9aa0a6"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding HwErrorsText}" FontSize="11" Foreground="#9aa0a6"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DevFeeText}" FontSize="11" Foreground="#9aa0a6"/>
                                                </Grid>

                                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                        <TextBlock Text="ЦЕПИ" FontSize="10" FontWeight="SemiBold" Foreground="#9aa0a6" Margin="0,0,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding Chains}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="40"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="120"/>
                                                                            <ColumnDefinition Width="90"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" FontSize="11" Foreground="#9aa0a6" Text="{Binding Id, StringFormat=#{0}}"/>
                                                                        <TextBlock Grid.Column="1" FontSize="11" Text="{Binding HashrateText}"/>
                                                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{Binding TempColor}" Text="{Binding TempText}"/>
                                                                        <TextBlock Grid.Column="3" FontSize="11" Foreground="#9aa0a6"><Run Text="{Binding HashratePercent, StringFormat={}{0:F0}%}"/></TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="ПУЛЫ" FontSize="10" FontWeight="SemiBold" Foreground="#9aa0a6" Margin="0,0,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding Pools}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding StatusColor}"/>
                                                                        <TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Url}"/>
                                                                        <TextBlock Grid.Column="2" FontSize="10" Margin="8,0,0,0" Foreground="#9aa0a6"><Run Text="A "/><Run Text="{Binding Accepted}"/><Run Text=" · R "/><Run Text="{Binding Rejected}"/><Run Text=" · "/><Run Text="{Binding PingMs}"/><Run Text="мс"/></TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>

                                                <DockPanel Grid.Row="4" Margin="0,14,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding FansText}" FontSize="11" VerticalAlignment="Center" Foreground="#9aa0a6"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <ui:Button Content="Настройки" Icon="{ui:SymbolIcon Settings24}" Margin="0,0,8,0" Command="{Binding OpenSettingsCommand}"/>
                                                        <ui:Button Content="Перезагрузка" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Danger" Margin="0,0,8,0" Command="{Binding RebootCommand}"/>
                                                        <ui:Button Content="Стоп" Icon="{ui:SymbolIcon Stop24}" Margin="0,0,8,0" Command="{Binding StopMiningCommand}"/>
                                                        <ui:Button Content="Старт" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Margin="0,0,8,0" Command="{Binding StartMiningCommand}"/>
                                                        <ui:Button Content="Рестарт" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RestartMiningCommand}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Компактный -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="Compact">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="16,8" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Устройство" FontSize="11" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                <TextBlock Grid.Column="1" Text="Воркер" FontSize="11" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                <TextBlock Grid.Column="2" Text="Статус / Дж/TH" FontSize="11" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                <TextBlock Grid.Column="3" Text="Хешрейт" FontSize="11" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                <TextBlock Grid.Column="4" Text="%" FontSize="11" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                <TextBlock Grid.Column="5" Text="Чип °C" FontSize="11" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                <TextBlock Grid.Column="6" Text="Плата °C" FontSize="11" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                                <TextBlock Grid.Column="7" Text="Действия" FontSize="11" FontWeight="SemiBold" Foreground="#9aa0a6"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MinersView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MinerItemViewModel}">
                                        <Border Padding="16,6" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding StateColor}"/>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Model}"/>
                                                    <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Hyperlink Command="{Binding OpenWebUiCommand}" Foreground="#9aa0a6" TextDecorations="None">
                                                            <Run Text="{Binding Ip}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding WorkerName}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{Binding StateColor}" Text="{Binding State, Converter={StaticResource EnumRu}}"/>
                                                    <TextBlock FontSize="11" Foreground="#9aa0a6" Text="{Binding EfficiencyDisplay}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center" Text="{Binding HashrateDisplay}"/>
                                                <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding HashrateColor}" Text="{Binding HashratePercentDisplay}"/>
                                                <TextBlock Grid.Column="5" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding TempColor}" Text="{Binding TempDisplay}"/>
                                                <TextBlock Grid.Column="6" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding PcbTempColor}" Text="{Binding BoardTempDisplay}"/>
                                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Icon="{ui:SymbolIcon Settings24}" Padding="6,2" Margin="0,0,4,0" ToolTip="Настройки" Command="{Binding OpenSettingsCommand}"/>
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Danger" Padding="6,2" Margin="0,0,4,0" ToolTip="Перезагрузка" Command="{Binding RebootCommand}"/>
                                                    <ui:Button Icon="{ui:SymbolIcon Stop24}" Padding="6,2" Margin="0,0,4,0" ToolTip="Стоп" Command="{Binding StopMiningCommand}"/>
                                                    <ui:Button Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Padding="6,2" Margin="0,0,4,0" ToolTip="Старт" Command="{Binding StartMiningCommand}"/>
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Padding="6,2" ToolTip="Рестарт" Command="{Binding RestartMiningCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ПУЛЫ -->
            <TabItem Header="Пулы">
                <Grid DataContext="{Binding Pools}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" Padding="24" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Text="Настройка воркеров" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="Базовый логин (воркер)" FontSize="12" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding BaseLogin, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Например: myfarm" Margin="0,0,0,16"/>
                            <TextBlock Text="Правило формирования суффикса" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="{Binding WorkerSuffixMode, Converter={StaticResource EnumToIndex}}" Margin="0,0,0,16">
                                <ComboBoxItem Content="По порядку (1, 2, 3...)" />
                                <ComboBoxItem Content="По последнему октету IP (например, .101)" />
                            </ComboBox>
                            <TextBlock Text="Пул 1 (Основной)" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <ui:TextBox Text="{Binding Pools[0].Url, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="stratum+tcp://..." Margin="0,0,0,8"/>
                            <ui:TextBox Text="{Binding Pools[0].Password, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Пароль (если требуется)" Margin="0,0,0,12"/>
                            <TextBlock Text="Пул 2 (Резервный)" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <ui:TextBox Text="{Binding Pools[1].Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <ui:TextBox Text="{Binding Pools[1].Password, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Пароль (если требуется)" Margin="0,0,0,12"/>
                            <TextBlock Text="Пул 3 (Резервный)" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <ui:TextBox Text="{Binding Pools[2].Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <ui:TextBox Text="{Binding Pools[2].Password, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Пароль (если требуется)" Margin="0,0,0,16"/>
                            <TextBlock Text="Пароль по умолчанию (если не задан в пулах)" FontSize="12" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding PoolPassword, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="x" Margin="0,0,0,24"/>

                            <ui:Button Content="Применить к выбранным" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding ApplyToSelectedCommand}"/>

                            <StackPanel Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="#9aa0a6"/>
                                <ProgressBar Value="{Binding ProgressCurrent}" Maximum="{Binding ProgressTotal}" Height="8" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel Grid.Column="1" Margin="16">
                        <TextBlock DockPanel.Dock="Top" Text="Выберите устройства" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Miners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" Margin="0,0,0,4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4">
                                            <CheckBox IsChecked="{Binding IsSelected}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Miner.Model}" FontWeight="SemiBold" Width="150" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Miner.Ip}" Width="120" VerticalAlignment="Center" Foreground="#9aa0a6"/>
                                                    <TextBlock Text="{Binding Miner.WorkerName}" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ПРОВЕРИТЬ ПИНГ -->
            <TabItem Header="Пинг пулов">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Padding="24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Задержка пулов K8X" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="Проверка скорости соединения с вашего компьютера до серверов пула." FontSize="12" Foreground="#9aa0a6" Margin="0,0,0,16"/>

                            <ItemsControl ItemsSource="{Binding PoolPings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Padding="16" Margin="0,0,12,12" Width="240">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock FontSize="11" Foreground="#9aa0a6" Margin="0,2,0,0">
                                                        <Run Text="{Binding Host, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PingDisplay, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{Binding StatusColor}" HorizontalAlignment="Right"/>
                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- РЕКЛАМНЫЙ БАННЕР K8X -->
                    <Border Grid.Row="1" Margin="24,0,24,24" Padding="20" CornerRadius="8" Background="#1e2329" BorderBrush="#f7931a" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Надежный пул для вашей фермы!" FontSize="18" FontWeight="Bold" Foreground="#e8eaed"/>
                                <TextBlock Text="K8X — стабильные выплаты, низкий пинг и поддержка BTC, LTC, ZEC." FontSize="12" Foreground="#9aa0a6" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Перейти на K8X" Icon="{ui:SymbolIcon ArrowRight24}" Appearance="Primary" Padding="20,12" VerticalAlignment="Center" Command="{Binding OpenK8xLinkCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- РАСПИСАНИЕ -->
            <TabItem Header="Расписание">
                <Grid DataContext="{Binding Schedules}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" Padding="16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Активные расписания" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding Schedules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold"><Run Text="{Binding Name}"/></TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="#9aa0a6"><Run Text="Область: "/><Run Text="{Binding TargetKind, Converter={StaticResource EnumRu}}"/><Run Text="  ·  Часовой пояс: "/><Run Text="{Binding TimeZoneId}"/></TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#9aa0a6"><Run Text="Активно: "/><Run Text="{Binding Enabled}"/><Run Text="  ·  Количество действий: "/><Run Text="{Binding Actions.Count, Mode=OneWay}"/></TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" Text="{Binding NextEventDescription}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <ui:Button Content="Вкл / Выкл" Margin="0,0,6,0" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    <ui:Button Content="Удалить" Appearance="Danger" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="1" Padding="16" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Создать расписание" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Название" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                <ui:TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Например: Ночной режим" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Область" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ComboBox ItemsSource="{Binding TargetKinds}" SelectedItem="{Binding NewTargetKind}" Width="180">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumRu}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewTargetKind}" Value="Miner">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Устройство" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ComboBox ItemsSource="{Binding Miners}" SelectedItem="{Binding SelectedMiner}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Content="Включено" IsChecked="{Binding NewEnabled}" VerticalAlignment="Bottom" Margin="0,0,16,6"/>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Часовой пояс:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#9aa0a6"/>
                                            <ComboBox ItemsSource="{Binding TimeZones}" SelectedItem="{Binding NewTimeZone}" MinWidth="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Шаблоны" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                <WrapPanel Margin="0,0,0,12">
                                    <ui:Button Content="Будни" Margin="0,0,6,6" Command="{Binding PresetWeekdaysCommand}"/>
                                    <ui:Button Content="Выходные" Margin="0,0,6,6" Command="{Binding PresetWeekendsCommand}"/>
                                    <ui:Button Content="Каждый день" Margin="0,0,6,6" Command="{Binding PresetEveryDayCommand}"/>
                                    <ui:Button Content="Очистить" Margin="0,0,6,6" Command="{Binding PresetClearCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="Расписание по дням" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                <ItemsControl ItemsSource="{Binding DayPlans}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DayPlanItem}">
                                            <Border Padding="8,6" Margin="0,0,0,6" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <ui:Button DockPanel.Dock="Right" Content="+ действие" Padding="8,2" HorizontalAlignment="Right" Command="{Binding DataContext.Schedules.AddActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="24,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:ActionItem}">
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="220"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="в" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#9aa0a6"/>
                                                                    <ui:TextBox Grid.Column="1" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="08:00" Margin="0,0,12,0" beh:TimeMaskBehavior.IsEnabled="True"/>
                                                                    <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#9aa0a6"/>
                                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.Schedules.AllActions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Action}" Margin="0,0,8,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={StaticResource EnumRu}}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Padding="6,2" HorizontalAlignment="Left" Command="{Binding DataContext.Schedules.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Content="Создать расписание" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,12,0,0" Command="{Binding CreateCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- УВЕДОМЛЕНИЯ -->
            <TabItem Header="Оповещения">
                <Grid DataContext="{Binding Alerts}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" Padding="16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Правила оповещений" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Обновить" Padding="10,4" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadCommand}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold"><Run Text="{Binding Name}"/><Run Text="   " /><Run Text="{Binding Type, Converter={StaticResource EnumRu}}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/></TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="#9aa0a6"><Run Text="Область: "/><Run Text="{Binding Target}"/><Run Text="   ·   Порог: "/><Run Text="{Binding Threshold}"/></TextBlock>
                                                    <TextBlock FontSize="11" Foreground="#9aa0a6"><Run Text="Включено: "/><Run Text="{Binding Enabled}"/><Run Text="   ·   Задержка: "/><Run Text="{Binding ForSeconds}"/><Run Text=" сек"/><Run Text="   ·   Интервал: "/><Run Text="{Binding CooldownSeconds}"/><Run Text=" сек"/></TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <ui:Button Content="Вкл / Выкл" Margin="0,0,6,0" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    <ui:Button Content="Удалить" Appearance="Danger" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="История событий" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8"/>
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,6" Margin="0,0,0,4" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="#9aa0a6"><Run Text="{Binding FiredAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"/><Run Text="   ·   "/><Run Text="{Binding RuleName}" FontWeight="SemiBold"/><Run Text="   ·   "/><Run Text="{Binding MinerIp}"/></TextBlock>
                                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Message}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="1" Padding="16" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Создать правило" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Название правила" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                <ui:TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Например: Падение хешрейта" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Событие" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ComboBox ItemsSource="{Binding AlertTypes}" SelectedItem="{Binding NewType}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumRu}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Область" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ComboBox ItemsSource="{Binding TargetKinds}" SelectedItem="{Binding NewTargetKind}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumRu}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewTargetKind}" Value="Miner">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Устройство" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                    <ComboBox ItemsSource="{Binding Miners}" SelectedItem="{Binding SelectedMiner}" Margin="0,0,0,12" MinHeight="32">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Порог" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ui:TextBox Text="{Binding NewThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Задержка (сек)" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ui:TextBox Text="{Binding NewForSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Интервал между срабатываниями (сек)" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                <ui:TextBox Text="{Binding NewCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                <CheckBox Content="Включить оповещение" IsChecked="{Binding NewEnabled}" Margin="0,0,0,12"/>
                                <ui:Button Content="Создать оповещение" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding CreateCommand}"/>
                                <TextBlock Text="{Binding CreateStatus}" Foreground="{Binding CreateStatusColor}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- НАСТРОЙКИ -->
            <TabItem Header="Настройки">
                <Grid DataContext="{Binding Settings}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" Padding="16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Telegram" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Border Padding="12" Margin="0,0,0,12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="#9aa0a6">
                                    <Run Text="1. Откройте бота "/><Run Text="@userinfobot" FontWeight="SemiBold"/><Run Text=" в Telegram"/><LineBreak/>
                                    <Run Text="2. Отправьте ему "/><Run Text="/start" FontWeight="SemiBold"/><Run Text=" — он пришлёт ваш ID"/><LineBreak/>
                                    <Run Text="3. Скопируйте ID и вставьте в поле ниже"/><LineBreak/><LineBreak/>
                                    <Run Text="4. Откройте бота "/><Run Text="@asicfarm_bot" FontWeight="SemiBold"/><Run Text=" и нажмите "/><Run Text="/start" FontWeight="SemiBold"/><Run Text=" для активации"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Chat ID" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                            <ui:TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="123456789" IsReadOnly="{Binding IsReadOnly}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:Button Content="Сохранить" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,0,8,0" Command="{Binding SaveTelegramCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Content="Отмена" Margin="0,0,8,0" Command="{Binding CancelEditCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Content="Изменить" Icon="{ui:SymbolIcon Edit24}" Margin="0,0,8,0" Command="{Binding BeginEditCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Content="Проверить" Icon="{ui:SymbolIcon Send24}" ToolTip="Отправить тестовое сообщение" Command="{Binding TestTelegramCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TelegramStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="1" Padding="16" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="Автоматические действия" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Обновить" Padding="10,4" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadCommand}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding AutoActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Card Padding="12" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,12,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#6b7280"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                        <Setter Property="Background" Value="#5cb85c"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}"/>
                                                            <TextBlock Text=" " />
                                                            <Border CornerRadius="4" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#3b4252"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                                <Setter Property="Background" Value="#2e5b2e"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="10" Foreground="White">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="ВЫКЛ"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                                    <Setter Property="Text" Value="АКТИВНО"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock FontSize="12" Margin="0,4,0,0" Foreground="#9aa0a6">
                                                            <Run Text="Условие: "/><Run Text="{Binding Trigger, Converter={StaticResource EnumRu}}" FontWeight="SemiBold"/>
                                                            <Run Text=" (Порог: "/><Run Text="{Binding Threshold}"/><Run Text=")"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" Foreground="#9aa0a6">
                                                            <Run Text="Реакция: "/><Run Text="{Binding Action, Converter={StaticResource EnumRu}}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                            <Run Text="   ·   Задержка: "/><Run Text="{Binding ForSeconds}"/><Run Text=" сек"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Content="Вкл / Выкл" Padding="8,2" Margin="0,0,4,0" Command="{Binding DataContext.ToggleAutoActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                        <ui:Button Content="Удалить" Appearance="Danger" Padding="8,2" Command="{Binding DataContext.DeleteAutoActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </ui:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Добавить автоматическое действие" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8"/>
                                <ui:TextBox Text="{Binding NewAutoName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Например: Перезагрузка при зависании" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Условие (Когда)" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ComboBox ItemsSource="{Binding Triggers}" SelectedItem="{Binding NewAutoTrigger}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumRu}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Реакция (Что сделать)" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding NewAutoAction}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumRu}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Порог" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ui:TextBox Text="{Binding NewAutoThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Задержка срабатывания (сек)" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                        <ui:TextBox Text="{Binding NewAutoForSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Интервал между срабатываниями (сек)" FontSize="11" Margin="0,0,0,4" Foreground="#9aa0a6"/>
                                <ui:TextBox Text="{Binding NewAutoCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                <CheckBox Content="Включить действие" IsChecked="{Binding NewAutoEnabled}" Margin="0,0,0,12"/>
                                <ui:Button Content="Создать действие" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding CreateAutoActionCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="3" Padding="16,8" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Foreground="#9aa0a6" Margin="0,0,16,0"/>
                    <TextBlock FontSize="11" Foreground="#9aa0a6"><Run Text="Устройств: "/><Run Text="{Binding Miners.Count, Mode=OneWay}"/></TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding AppVersion}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,16,0"
                               Foreground="#9aa0a6"
                               FontSize="11"/>

                    <ToggleButton Width="120" Height="26" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WeatherMoon24" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Тема" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>