<Window x:Class="AsicFarm.Client.Views.MinerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:AsicFarm.Client.ViewModels"
        Title="{Binding Title}"
        Height="900" Width="1400"
        WindowStartupLocation="CenterOwner"
        Background="#111418"
        Foreground="#e8eaed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="12" Height="12" Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             Fill="{Binding StateColor}"/>
                    <TextBlock Text="{Binding ModelText}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Padding="10,3" CornerRadius="10"
                            Background="{Binding StateColor}"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="{Binding UptimeText}" FontSize="11" Margin="12,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}"
                           Content="Закрыть" Padding="12,6"
                           Click="Close_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60"
                                 HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LoadingText}" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="600"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Не удалось получить детальный снапшот"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Error}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <ui:Card Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ХЕШРЕЙТ" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="{Binding HashrateText}" FontSize="18" FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ТЕМПЕРАТУРА" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="{Binding TempText}" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="МОЩНОСТЬ" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="{Binding PowerText}" FontSize="18" FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding EfficiencyText}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="ПРОШИВКА" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="{Binding FirmwareText}" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ФАБРИЧНАЯ ИНФОРМАЦИЯ" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock FontSize="12" Margin="0,2,0,2">
                                    <Run Text="PSU модель: " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Run Text="{Binding PsuModelText}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,2,0,2">
                                    <Run Text="PSU серийник: " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Run Text="{Binding PsuSerialText}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,2,0,2">
                                    <Run Text="Стоковый хешрейт: " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Run Text="{Binding StockHashrateText}"/>
                                </TextBlock>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="1" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ВЕНТИЛЯТОРЫ" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock FontSize="12" Margin="0,2,0,2">
                                    <Run Text="Режим: " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Run Text="{Binding FanModeText}"/>
                                    <Run Text="   ·   ШИМ: " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Run Text="{Binding FanDutyPercent}"/><Run Text="%"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Fans}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Margin="0,2,0,2">
                                                <Run Text="Вентилятор #"/>
                                                <Run Text="{Binding Id}"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding Rpm}"/><Run Text=" об/мин"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Chains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChainDetailVM}">
                                <ui:Card Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding StateColor}"/>
                                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                                    <Run Text="Цепь #"/>
                                                    <Run Text="{Binding Id}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StateText}" FontSize="12"
                                                           Margin="12,3,0,0"
                                                           Foreground="{Binding StateColor}"/>
                                                <TextBlock FontSize="12" Margin="20,3,0,0">
                                                    <Run Text="{Binding HashrateText}"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding NominalText}"/>
                                                    <Run Text="  ("/>
                                                    <Run Text="{Binding HashratePercent, StringFormat={}{0:F1}%}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Margin="20,3,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Частота "/>
                                                    <Run Text="{Binding FrequencyMhz, StringFormat={}{0:F0}}"/>
                                                    <Run Text=" МГц"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding RowsData}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="22" Height="22"
                                                                        Margin="1"
                                                                        CornerRadius="3"
                                                                        Background="{Binding Color}"
                                                                        ToolTip="{Binding Tooltip}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="Холодный" FontSize="10" Margin="0,0,4,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <Border Width="20" Height="10" CornerRadius="2" Background="#2d7ff9" Margin="0,0,8,0"/>
                                            <Border Width="20" Height="10" CornerRadius="2" Background="#3fb950" Margin="0,0,8,0"/>
                                            <Border Width="20" Height="10" CornerRadius="2" Background="#d29922" Margin="0,0,8,0"/>
                                            <Border Width="20" Height="10" CornerRadius="2" Background="#f0883e" Margin="0,0,8,0"/>
                                            <Border Width="20" Height="10" CornerRadius="2" Background="#f85149" Margin="0,0,8,0"/>
                                            <TextBlock Text="Горячий" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>