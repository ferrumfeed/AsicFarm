<Window x:Class="AsicFarm.Client.Views.MinerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Height="820" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#111418"
        Foreground="#e8eaed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Padding="20,16"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}"
                           Content="Закрыть" Padding="12,6" Click="Close_Click"/>
            </DockPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Целевая температура -->
                <ui:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Целевая температура" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Text="{Binding TargetTemp, UpdateSourceTrigger=PropertyChanged}"
                                        Width="80" VerticalContentAlignment="Center"/>
                            <TextBlock Text="°C" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Охлаждение -->
                <ui:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Охлаждение" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Text="Режим работы" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ComboBox SelectedValue="{Binding CoolingMode}" SelectedValuePath="Tag" Margin="0,0,0,12">
                            <ComboBoxItem Content="Автоматический" Tag="auto"/>
                            <ComboBoxItem Content="Ручной" Tag="manual"/>
                        </ComboBox>

                        <!-- Показываем ШИМ только в ручном режиме -->
                        <StackPanel Visibility="{Binding IsManualCooling, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="ШИМ вентиляторов (%)" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ui:TextBox Text="{Binding FanDuty, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Безопасность -->
                <ui:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Безопасность" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <CheckBox Content="Тихий режим" IsChecked="{Binding QuietMode}" Margin="0,0,0,12" Foreground="#e8eaed"
                                  ToolTip="Снижает скорость вентиляторов. Майнер может перезагрузиться для применения."/>

                        <TextBlock Text="Аварийный рестарт при (°C)" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip="Если чип нагреется до этой температуры, майнер автоматически перезагрузится для защиты."/>
                        <ui:TextBox Text="{Binding RestartTemp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Задержка старта (сек)" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip="Задержка включения вентиляторов при старте (для инверторных БП)."/>
                        <ui:TextBox Text="{Binding StartupDelay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Переключатель пресетов -->
                <ui:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Переключатель пресетов" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <CheckBox Content="Включён" IsChecked="{Binding PresetSwitcherEnabled}" Margin="0,0,0,12" Foreground="#e8eaed"/>

                        <TextBlock Text="Мин. пресет (обычный режим)" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailablePresets}"
                                  SelectedItem="{Binding SelectedMinPreset}"
                                  DisplayMemberPath="Pretty"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Макс. пресет (при перегреве)" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailablePresets}"
                                  SelectedItem="{Binding SelectedMaxPreset}"
                                  DisplayMemberPath="Pretty"
                                  Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Темп. повышения (°C)" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <ui:TextBox Text="{Binding RiseTemp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Темп. понижения (°C)" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <ui:TextBox Text="{Binding DecreaseTemp, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <ui:Button Content="Применить переключатель"
                                   Command="{Binding ApplyPresetSwitcherCommand}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Left"
                                   Padding="16,8"/>

                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Сохранение -->
                <ui:Button Content="Сохранить основные настройки"
                           Command="{Binding SaveCommand}"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           Padding="16,10" Margin="0,8,0,0"/>

                <!-- Статус -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0" HorizontalAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>