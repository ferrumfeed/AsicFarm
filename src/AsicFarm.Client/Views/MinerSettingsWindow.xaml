<Window x:Class="AsicFarm.Client.Views.MinerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Настройки майнера" Height="550" Width="450"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Охлаждение" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Целевая температура (°C)" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding TargetTemp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <TextBlock Text="Режим охлаждения" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox SelectedValue="{Binding CoolingMode}" Margin="0,0,0,15">
                <ComboBoxItem Content="Auto (автоматически)" Tag="auto" IsSelected="True"/>
                <ComboBoxItem Content="Manual (вручную)" Tag="manual"/>
            </ComboBox>

            <TextBlock Text="Обороты вентиляторов (если Manual, %)" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding FanDuty, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <CheckBox Content="Тихий режим (Quiet Mode)" IsChecked="{Binding QuietMode}" Margin="0,0,0,20"/>

            <TextBlock Text="Безопасность" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Температура аварийного рестарта (°C)" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding RestartTemp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <TextBlock Text="Задержка старта (сек)" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding StartupDelay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

            <ui:Button Content="Сохранить" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,0,0,10" Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>