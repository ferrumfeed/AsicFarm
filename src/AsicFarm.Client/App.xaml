<Application x:Class="AsicFarm.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:AsicFarm.Client.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Подключаем базовые стили и контролы WPF UI -->
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Твои существующие конвертеры -->
            <conv:EnumToRussianConverter x:Key="EnumRu"/>
            <conv:PercentToWidthConverter x:Key="PctToW"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- НОВЫЙ КОНВЕРТЕР (добавлена эта строка) -->
            <conv:EnumToIndexConverter x:Key="EnumToIndex"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>